{
  "expo": {
    "name": "GymView",
    "slug": "gymview",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "gymview",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gymview.app"
    },
    "android": {
      "package": "com.gymview.app"
    },
    "plugins": [
      "expo-router"
    ],
    "web": {
      "bundler": "metro"
    }
  }
}